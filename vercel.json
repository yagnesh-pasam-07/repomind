{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/build-static.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/brand/:path*",
      "destination": "/brand/:path*"
    },
    {
      "source": "/social-preview.png",
      "destination": "/social-preview.png"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{dist/**,examples/sumitra-like/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 6 * * *"
    }
  ]
}
