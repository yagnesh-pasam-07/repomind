{
  "name": "repomind",
  "version": "0.1.0",
  "description": "Live map of your codebase, infrastructure and integrations \u2014 with PR diffs, security and cost flags.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-viewer.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "serve": "npm run build && node bin/repomind.js serve"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "roughjs": "^4.6.6",
    "tar": "^7.5.22",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "repomind": "bin/repomind.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "PRODUCT.md"
  ],
  "keywords": [
    "architecture",
    "diagram",
    "visualizer",
    "github-action",
    "security",
    "devops"
  ]
}
